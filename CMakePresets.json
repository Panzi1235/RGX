{
  "version": 3,
  "configurePresets": [
    {
      "name": "windows-x64",
      "displayName": "Windows x64 (MSVC + vcpkg)",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux",
      "displayName": "Linux (gcc, libs del sistema)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build-linux",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "OCRX_CON_PDFIUM": "OFF", "OCRX_CON_QUIRC": "OFF", "OCRX_CON_IMAGENES": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "windows-x64", "configurePreset": "windows-x64", "configuration": "Release" },
    { "name": "linux", "configurePreset": "linux" }
  ],
  "testPresets": [
    { "name": "windows-x64", "configurePreset": "windows-x64", "configuration": "Release" },
    { "name": "linux", "configurePreset": "linux" }
  ]
}
